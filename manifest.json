{
  "manifest_version": 3,
  "name": "Doubt Helper",
  "version": "0.1.0",
  "description": "Notices when you keep deleting your writing and finds keywords for who could help.",
  "background": { "service_worker": "dist/background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
